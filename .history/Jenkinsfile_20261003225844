pipeline {
    agent any

    environment {
        IMAGE_NAME = "localhost:5000/project-nexus"
        IMAGE_TAG  = "${BUILD_NUMBER}"
    }

    stages {

        stage('Test') {
            steps {
                sh '''
                    rm -rf .venv
                    python3 -m venv .venv
                    . .venv/bin/activate
                    pip install --no-cache-dir -r applications/requirements.txt
                    python -m py_compile applications/app.py
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build \
                      -t ${IMAGE_NAME}:${IMAGE_TAG} \
                      -t ${IMAGE_NAME}:latest \
                      .
                '''
            }
        }

        stage('Security Scan') {
    steps {
        sh '''
            trivy image \
              --severity CRITICAL \
              --exit-code 1 \
              --no-progress \
              ${IMAGE_NAME}:${IMAGE_TAG}
        '''
    }
}

        stage('Push Image') {
            steps {
                sh '''
                    docker push ${IMAGE_NAME}:${IMAGE_TAG}
                    docker push ${IMAGE_NAME}:latest
                '''
            }
        }

        stage('Update GitOps') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'bf209c58-b023-4ddd-95a1-a06ca6b97f86',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        git config user.name "Project Nexus Jenkins"
                        git config user.email "jenkins@project-nexus.local"

                        sed -i \
                          "s|image: localhost:5000/project-nexus:.*|image: localhost:5000/project-nexus:${IMAGE_TAG}|" \
                          k8s/deployment.yaml

                        git add k8s/deployment.yaml

                        if git diff --cached --quiet; then
                            echo "No GitOps changes detected."
                            exit 0
                        fi

                        git commit -m "deploy project-nexus:${IMAGE_TAG} [skip ci]"

                        git push \
                          https://${GIT_USERNAME}:${GIT_TOKEN}@github.com/VaishnaviLatey21/project-nexus.git \
                          HEAD:main
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Project Nexus CI completed successfully. ArgoCD will deploy the new image.'
        }

        failure {
            echo 'Project Nexus CI failed.'
        }
    }
}